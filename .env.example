# Copy to .env and adjust values for local Docker Compose runs.
SERVER_PORT=8081
MONGO_PORT=27018

# Must be at least 32 characters. Prefer a random Base64 string in real environments.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MS=3600000
JWT_ISSUER=hospital-management

SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FULL_NAME=Hospital Admin
